  "reproduction": {
    "working_directory": "Repository root containing both local Git revisions and retained final directories.",
    "method": "Read-only git show reconstruction; reads all 63 source blobs from each commit, never runs composer, deployer, Docker, GPU workloads or remote commands. Compare computed per-target hashes with each retained expected manifest, reconstruct exact deployment bytes and compile content JSON, and assert both observed 12-character stamps.",
    "python": "import hashlib,json,re,shlex,subprocess\nfrom pathlib import Path\n\ndef sha(raw):\n    return hashlib.sha256(raw).hexdigest()\n\ndef reconstruct():\n    root=Path.cwd()\n    image=\"sha256:a3dd4c0f6cbb053097d65d10cd8ff8f6ae0cb9115cf0ff142e1cafe124c09211\"\n    inputs=(\n        (\"candidate\",\"c85a1e75a7187ad69baefb30ef143f92f13430e8\",\"measurements/glm53_sf6_unpack_onepass_20260909/final\"),\n        (\"baseline\",\"c03da265a893c61e759eb56e2e43f77bac74a2cc\",\"measurements/glm53_sf6_unpack_baseline_20260909/final\"))\n    sides, bodies, datasets, records = {}, {}, {}, {}\n    for mode, revision, relative in inputs:\n        def blob(path):\n            return subprocess.check_output([\"git\",\"show\",revision+\":\"+path],cwd=root)\n        profile=blob(\"profiles/glm53.env\").decode()\n        modules=shlex.split(re.search(r\"^MODULES=(.+)$\",profile,re.M)[1])[0].split()\n        prefix=shlex.split(re.search(r\"^TARGET_PREFIX=(.+)$\",profile,re.M)[1])[0]\n        rows, content, files = [], [], {}\n        for module in modules:\n            for line in blob(\"overlay/modules/\"+module+\"/manifest.tsv\").decode().splitlines():\n                if not line or line.startswith(\"#\"):\n                    continue\n                source,target,contract=line.split(\"\\t\")\n                target=target if target.startswith(\"/\") else prefix+target\n                path=\"overlay/modules/\"+module+\"/\"+source\n                digest=sha(blob(path))\n                assert source not in files\n                files[source]=dict(path=path,target=target,base_contract=contract,sha256=digest)\n                rows.append([source,target,contract])\n                content.append([source,target,contract,digest])\n        body=\"\".join(\"\\t\".join(row)+\"\\n\" for row in rows).encode()\n        header=(\"# source_commit=\"+revision+\"\\n\").encode()\n        manifest=header+body\n        directory=root/relative\n        raw_record=(directory/\"records.raw.jsonl\").read_bytes()\n        lines=[line for line in raw_record.splitlines() if line.strip()]\n        assert len(lines)==1\n        record=json.loads(lines[0])\n        expected_path=directory/(\"expected-\"+record[\"name\"]+\".json\" if mode==\"candidate\" else \"baseline-expected.json\")\n        expected=json.loads(expected_path.read_bytes())\n        actual_sources={value[\"target\"]:value[\"sha256\"] for value in files.values()}\n        assert len(files)==len(expected)==63 and actual_sources==expected\n        content_bytes=json.dumps([\"glm53-compile-v1\",image,sorted(content)],separators=(\",\",\":\")).encode()\n        deployment_sha=sha(manifest)\n        assert deployment_sha[:12]==record[\"overlay\"]\n        sides[mode]=dict(source_commit=revision,record_name=record[\"name\"],\n            record_raw_line_sha256=sha(lines[0]),record_overlay=record[\"overlay\"],\n            source_file_count=len(files),git_sources_match_retained_expected_manifest=True,\n            expected_manifest_sha256=sha(expected_path.read_bytes()),\n            source_commit_header=header.decode(),manifest_without_header_sha256=sha(body),\n            deployment_manifest_sha256=deployment_sha,reconstructed_stamp=deployment_sha[:12],\n            reconstructed_stamp_matches_record=True,compile_content_sha256=sha(content_bytes),\n            workload=record[\"workload\"],harness=record[\"harness\"],doc_lang=record[\"doc_lang\"],\n            thinking=record[\"thinking\"],window_s=record[\"window_s\"],cold_compile=record.get(\"cold_compile\",False))\n        bodies[mode],datasets[mode],records[mode]=body,files,record\n    assert datasets[\"candidate\"]==datasets[\"baseline\"] and bodies[\"candidate\"]==bodies[\"baseline\"]\n    keys=(\"workload\",\"harness\",\"doc_lang\",\"thinking\",\"window_s\")\n    assert all(records[\"candidate\"][key]==records[\"baseline\"][key] for key in keys)\n    return dict(schema=\"sf6-unpack-stamp-provenance-v1\",image=image,sides=sides,\n        workload_equal=True,workload_metadata_equal=True,deployment_stamp_equal=False,\n        stamp_difference_reason=\"source_commit_header_only\",manifest_rows_byte_identical=True,\n        git_serving_sources_equal=True,compile_content_sha256_equal=True,\n        source_files=[dict(source=source,**value) for source,value in sorted(datasets[\"candidate\"].items())],\n        conclusion=\"The deployment stamps differ solely because deploy-overlays prepends different source_commit headers to otherwise byte-identical 63-row manifests. The workload and runtime content hashes are equal. This does not remove the strict different-stamp rejection or establish a valid A/B performance/adoption verdict.\")\n\nif __name__ == \"__main__\":\n    print(json.dumps(reconstruct(),indent=2))\n",
    "command": "python3 -B -c 'import json; from pathlib import Path; p=Path(\"measurements/glm53_sf6_unpack_baseline_20260909/stamp-provenance.json\"); exec(json.loads(p.read_text())[\"reproduction\"][\"python\"])'"
