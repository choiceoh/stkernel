-// A row too wide for the bin cache falls back to reading the row a second time; a bin too
-// wide for the stash falls back to refining against the row. Both are exact.
+// A row too wide for the bin cache falls back to reading the row a second time. A threshold
+// bin too wide for the stash is split once more: one pass histograms the bin's elements over
+// the fp32 key range the bin can hold, cut into 256, and only that sub-bin goes to the stash.
+// Only a sub-bin still too wide (a plateau of equal scores) refines against the row. All exact.
+//
+// GB10 is where the second split matters: 48 KB of shared memory a block leaves no bin cache
+// past 24,576 candidates and 2,560 stash slots, and on a skewed row of 131,072 the old byte-wise
+// refinement re-read the row up to eight times -- 228 us against a 12 us read floor
+// (measurements/st_topk_hpcops_20260917).
 //
 // The key is (ordered_float_key(score) << 32) | ~index, so an exact tie chooses the LOWER
 // pool id. That is what torch.topk(sorted=False) does here: measured over single- and
@@ -100,6 +107,53 @@ __device__ __forceinline__ int st_coarse_bin(float x) {
   return (int)(key >> 8);
 }
 
+// The ordered-key range [lo, hi] every fp32 score in coarse bin `coarse` falls in, widened by an
+// fp32 ulp on each side (a wider range is still exact; it only makes the sub-bins coarser). The
+// bin fixes the fp16 sign, exponent E and the top two mantissa bits; its scores lie between the
+// fp16 rounding midpoints around that code range. Exponents 0, 1 (subnormal spacing and signed
+// zero), 30 and 31 (overflow to inf, NaN) take the whole key space instead.
+__device__ __forceinline__ void st_bin_key_range(int coarse, st_u32* lo, st_u32* hi) {
+  const int positive = coarse >= 0x80;
+  const st_u32 code = positive ? ((st_u32)coarse & 0x7fu) : (~(st_u32)coarse & 0x7fu);
+  const st_u32 e = code >> 2, m2 = code & 3u;
+  if (e < 2u || e > 29u) {
+    *lo = 0u;
+    *hi = 0xffffffffu;
+    return;
+  }
+  const st_u32 exp32 = e + 112u;
+  const st_u32 mid_lo = m2 ? ((exp32 << 23) | ((m2 << 21) - 0x1000u))
+                           : (((exp32 - 1u) << 23) | 0x7ff000u);
+  const st_u32 mid_hi = (exp32 << 23) | ((((m2 << 8) | 0xffu) << 13) + 0x1000u);
+  const st_u32 mag_lo = mid_lo - 1u, mag_hi = mid_hi + 1u;
+  if (positive) {
+    *lo = mag_lo | 0x80000000u;
+    *hi = mag_hi | 0x80000000u;
+  } else {
+    *lo = ~(mag_hi | 0x80000000u);
+    *hi = ~(mag_lo | 0x80000000u);
+  }
+}
+
+// The shift that folds a key range into 256 sub-bins: (key - lo) >> shift is in [0, 255].
+__device__ __forceinline__ int st_fine_shift(st_u32 lo, st_u32 hi) {
+  const st_u32 span = hi - lo;
+  int shift = 0;
+#pragma unroll 24
+  for (int i = 0; i < 24; ++i)
+    if ((span >> shift) > 0xffu) ++shift;
+  return shift;
+}
+
+// A key's sub-bin, clamped to the range. The clamp never reorders keys (it is monotone), so even
+// a range that missed an element would only lump it into an end sub-bin, which the stash's full
+// 64-bit keys still order exactly -- and it keeps the index inside `hist` whatever happens.
+__device__ __forceinline__ int st_fine_bin(st_u32 key, st_u32 lo, st_u32 hi, int shift) {
+  if (key <= lo) return 0;
+  if (key >= hi) return (int)((hi - lo) >> shift);
+  return (int)((key - lo) >> shift);
+}
+
 __device__ __forceinline__ st_u64 st_stash_key(st_u32 ordered, int index) {
   return ((st_u64)ordered << 32) | (st_u32)(~(st_u32)index);
 }
@@ -283,9 +337,59 @@ __global__ __launch_bounds__(ST_THREADS) void st_dsa_select(
     return;
   }
 
+  // A threshold bin wider than the stash: split it once over its own key range. `fine_cut` >= 0
+  // means the sift below classifies coarse-bin elements by sub-bin instead of sending them all
+  // to the stash, and `need` then counts only what the cut sub-bin must still supply.
+  int fine_cut = -1;
+  st_u32 fine_lo = 0u, fine_hi = 0xffffffffu;
+  int fine_shift = 0;
   if (coarse_pop > stash_slots) {
-    // A bin wider than the stash. Refine the 64-bit key a byte at a time against the row
-    // itself. Bounded at eight rounds because the key is unique per element.
+    st_bin_key_range(coarse, &fine_lo, &fine_hi);
+    fine_shift = st_fine_shift(fine_lo, fine_hi);
+    for (int i = tx; i <= ST_RADIX; i += nt) hist[i] = 0;
+    __syncthreads();
+    // One more pass over the row, four floats to a thread like the sweep; only the threshold
+    // bin's elements count.
+    const int fine_quads = (((st_u64)(size_t)in & 15ull) == 0ull) ? (length >> 2) : 0;
+    for (int i = tx; i < fine_quads; i += nt) {
+      const float4 v = __ldg(reinterpret_cast<const float4*>(in) + i);
+      const float four[4] = {v.x, v.y, v.z, v.w};
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        if (st_coarse_bin(four[j]) != coarse) continue;
+        st_hist_add(hist, st_fine_bin(st_ordered_key(four[j]), fine_lo, fine_hi, fine_shift));
+      }
+    }
+    for (int i = (fine_quads << 2) + tx; i < length; i += nt) {
+      if (ST_BIN_AT(i) != coarse) continue;
+      st_hist_add(hist, st_fine_bin(st_ordered_key(in[i]), fine_lo, fine_hi, fine_shift));
+    }
+    __syncthreads();
+    st_suffix_and_pick(hist, need, &threshold_bin);
+    __syncthreads();
+    const int cut = threshold_bin;
+    const int fine_need = need - hist[cut + 1];
+    const int fine_pop = hist[cut] - hist[cut + 1];
+    if (fine_pop <= stash_slots) {
+      fine_cut = cut;
+      need = fine_need;
+      if (need == 0) {  // the cut falls on a sub-bin edge
+        for (int i = tx; i < length; i += nt) {
+          const int b = ST_BIN_AT(i);
+          if (b > coarse || (b == coarse
+              && st_fine_bin(st_ordered_key(in[i]), fine_lo, fine_hi, fine_shift) > fine_cut))
+            ST_EMIT(i);
+        }
+        ST_PUBLISH();
+        return;
+      }
+    }
+  }
+
+  if (fine_cut < 0 && coarse_pop > stash_slots) {
+    // A sub-bin still wider than the stash: a plateau of (nearly) equal scores. Refine the
+    // 64-bit key a byte at a time against the row itself. Bounded at eight rounds because the
+    // key is unique per element.
     if (tx == 0) key_prefix = 0;
     __syncthreads();
 #pragma unroll 8
@@ -330,6 +434,10 @@ __global__ __launch_bounds__(ST_THREADS) void st_dsa_select(
   // bin's own candidates go to the stash. Only these few touch DRAM again.
   for (int i = tx; i <= ST_RADIX; i += nt) hist[i] = 0;
   __syncthreads();
+// An element of the threshold bin by sub-bin: -1 when the bin was not split, so every one of
+// them equals the "cut" and goes to the stash exactly as before.
+#define ST_FINE_AT(idx) \
+  (fine_cut < 0 ? -1 : st_fine_bin(st_ordered_key(in[(idx)]), fine_lo, fine_hi, fine_shift))
   // One atomic a thread a class instead of one an element: a thread classifies its four
   // bins into two masks and claims that many slots at once.
 #define ST_SIFT_QUAD(q, base)                                            \
@@ -338,7 +446,11 @@ __global__ __launch_bounds__(ST_THREADS) void st_dsa_select(
     _Pragma("unroll") for (int _j = 0; _j < 4; ++_j) {                    \
       const int _b = (int)(((q) >> (_j * 8)) & 0xffu);                   \
       if (_b > coarse) _hi |= 1 << _j;                                   \
-      else if (_b == coarse) _eq |= 1 << _j;                             \
