+class SubBinRangeTests(unittest.TestCase):
+    """The threshold-bin split: every fp32 score a coarse bin can hold lies in the key range the
+    kernel computes for that bin, so its 256 sub-bins keep the order the stash then resolves.
+
+    Mirrors `st_bin_key_range`, `st_fine_shift` and `st_fine_bin` in Python and checks them at the
+    places a range could be wrong: both sides of every fp16 rounding midpoint, for every code.
+    """
+
+    @staticmethod
+    def key_range(coarse):
+        positive = coarse >= 0x80
+        code = (coarse & 0x7F) if positive else (~coarse & 0x7F)
+        e, m2 = code >> 2, code & 3
+        if e < 2 or e > 29:
+            return 0, 0xFFFFFFFF
+        exp32 = e + 112
+        mid_lo = (exp32 << 23) | ((m2 << 21) - 0x1000) if m2 else ((exp32 - 1) << 23) | 0x7FF000
+        mid_hi = (exp32 << 23) | ((((m2 << 8) | 0xFF) << 13) + 0x1000)
+        mag_lo, mag_hi = mid_lo - 1, mid_hi + 1
+        if positive:
+            return mag_lo | 0x80000000, mag_hi | 0x80000000
+        return (~(mag_hi | 0x80000000)) & 0xFFFFFFFF, (~(mag_lo | 0x80000000)) & 0xFFFFFFFF
+
+    @staticmethod
+    def fine_shift(lo, hi):
+        span, shift = (hi - lo) & 0xFFFFFFFF, 0
+        for _ in range(24):
+            if (span >> shift) > 0xFF:
+                shift += 1
+        return shift
+
+    @staticmethod
+    def fine_bin(key, lo, hi, shift):
+        if key <= lo:
+            return 0
+        if key >= hi:
+            return (hi - lo) >> shift
+        return (key - lo) >> shift
+
+    def test_the_kernel_carries_the_mirrored_range(self):
+        text = SOURCE.read_text(encoding="utf-8")
+        for needle in ("st_bin_key_range", "st_fine_shift", "st_fine_bin", "e < 2u || e > 29u",
+                       "exp32 = e + 112u", "0x7ff000u", "(m2 << 21) - 0x1000u", "+ 0x1000u"):
+            self.assertIn(needle, text)
+
+    @unittest.skipUnless(importlib.util.find_spec("numpy") is not None, "requires numpy")
+    def test_every_score_near_every_fp16_rounding_edge_lies_in_its_bins_range(self):
+        import numpy as np
+        codes = np.arange(1 << 15, dtype=np.uint32)          # fp16 magnitudes
+        exps, mans = codes >> 10, codes & 0x3FF
+        normal = (exps >= 1) & (exps <= 30)
+        values = np.where(normal, np.ldexp(1.0 + mans / 1024.0, exps.astype(np.int64) - 15), 0.0)
+        ulp = np.ldexp(1.0, exps.astype(np.int64) - 25)       # half an fp16 step
+        probes = []
+        for mid in (values - ulp, values + ulp):
+            m32 = mid.astype(np.float32)
+            probes += [m32, np.nextafter(m32, np.float32(np.inf)), np.nextafter(m32, np.float32(0))]
+        probes.append(values.astype(np.float32))
+        x = np.concatenate(probes)
+        x = x[np.isfinite(x) & (x > 0)]
+        x = np.concatenate([x, -x])
+        with np.errstate(over="ignore"):
+            h = x.astype(np.float16).view(np.uint16).astype(np.uint32)
+        key16 = np.where(h & 0x8000, ~h & 0xFFFF, h | 0x8000)
+        coarse = key16 >> 8
+        bits = x.view(np.uint32).astype(np.uint64)
+        ordered = np.where(bits & 0x80000000, ~bits & 0xFFFFFFFF, bits | 0x80000000)
+        checked = 0
+        for c in np.unique(coarse):
+            lo, hi = self.key_range(int(c))
+            keys = ordered[coarse == c]
+            if (lo, hi) == (0, 0xFFFFFFFF):
+                continue
+            checked += keys.size
+            self.assertGreaterEqual(int(keys.min()), lo, hex(int(c)))
+            self.assertLessEqual(int(keys.max()), hi, hex(int(c)))
+            shift = self.fine_shift(lo, hi)
+            self.assertLessEqual((hi - lo) >> shift, 255, hex(int(c)))
+            bins = [self.fine_bin(int(k), lo, hi, shift) for k in np.sort(keys)[:: max(1, keys.size // 64)]]
+            self.assertEqual(bins, sorted(bins), "sub-bins must not reorder keys")
+        self.assertGreater(checked, 300000)
+
+    def test_the_whole_key_space_still_folds_into_256_sub_bins(self):
+        shift = self.fine_shift(0, 0xFFFFFFFF)
+        self.assertEqual(shift, 24)
+        self.assertEqual(self.fine_bin(0xFFFFFFFF, 0, 0xFFFFFFFF, shift), 255)
+        lo, hi = self.key_range(0x80 | (5 << 2) | 1)            # a positive, normal bin
+        shift = self.fine_shift(lo, hi)
+        self.assertEqual(self.fine_bin(lo - 7, lo, hi, shift), 0, "below the range clamps to 0")
+        self.assertEqual(self.fine_bin(hi + 7, lo, hi, shift), (hi - lo) >> shift)
+
+
