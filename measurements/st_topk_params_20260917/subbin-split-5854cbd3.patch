+        else if (_f == fine_cut) _eq |= 1 << _j;                         \
+      }                                                                  \
     }                                                                    \
     if (_hi) {                                                           \
       int _p = atomicAdd(&counter, __popc(_hi));                         \
@@ -366,9 +478,10 @@ __global__ __launch_bounds__(ST_THREADS) void st_dsa_select(
   for (int i = tx; i < quads; i += nt) ST_SIFT_QUAD(ST_QUAD_AT(i), i << 2)
   for (int i = (quads << 2) + tx; i < length; i += nt) {
     const int b = ST_BIN_AT(i);
-    if (b > coarse) {
+    const int f = b == coarse ? ST_FINE_AT(i) : 0;
+    if (b > coarse || (b == coarse && f > fine_cut)) {
       ST_EMIT(i);
-    } else if (b == coarse) {
+    } else if (b == coarse && f == fine_cut) {
       const int p = atomicAdd(&num_input[0], 1);
       if (p < stash_slots) {
         const st_u32 key = st_ordered_key(in[i]);
@@ -379,6 +492,7 @@ __global__ __launch_bounds__(ST_THREADS) void st_dsa_select(
     }
   }
 #undef ST_SIFT_QUAD
+#undef ST_FINE_AT
   __syncthreads();
 
 #pragma unroll 8
