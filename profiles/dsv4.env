# DeepSeek-V4-Flash-0731 -- 4x DGX Spark GB10, TP=4. Production.
PROFILE_DESC="DeepSeek-V4-Flash-0731 TP=4 (production)"
PROFILE_IMAGE="aidendle94/sparkrun-vllm-ds4-gb10:production-hybrid-1.6"
PROFILE_MODEL_PATH="/home/choiceoh/models/DeepSeek-V4-Flash-0731"
PROFILE_SERVED_NAME="deepseek-v4-flash"
PROFILE_LAUNCHER="start-hy4-tp4.sh"

# Compile DSpark rejection-sampler and input-preparation Triton signatures
# before the server accepts traffic. Set to 0 for a rollback-only boot.
VLLM_DSV4_SPEC_WARMUP=1

# The package root, not the vllm/ directory inside it: modules that are
# portable across images write their target relative to this, and a module
# may bind something outside vllm (flashinfer, on other profiles).
TARGET_PREFIX="/opt/venv/lib/python3.12/site-packages/"

MODULES="tp_oneshot_ar dsv4_oneshot_wiring moe_gate_sm121 spec_fp8_head mla_indexer mla_sparse_swa dsv4_attention dsv4_flashinfer_sparse dsv4_model dsv4_eager_scratch dsv4_ops_cache_utils dsv4_ops_fused_indexer_q dsv4_mhc_tilelang glm53_megakernel dspark_drafter dsv4_tokenizer deepseek_reasoning deepseek_tool_parser"

# --- serving knobs -----------------------------------------------------------
# glm53_megakernel: the sm_121a decode kernel core. Mounted, entirely OFF.
#
# It carries no model file -- its two rows bind vllm/model_executor/layers/
# relative to TARGET_PREFIX and both are new files (preimage `absent`), which
# is what lets this profile mount the same module GLM-5.3 runs. The name still
# says glm53; renaming the module, its sources and its knobs touches 86 refs
# across 21 files (the ledger among them, which must not be rewritten), so the
# rename waits until this model measures a win worth paying for.
#
# ONE segment is reachable here: MK_SEG_MHC. V4-Flash's hyper-connection block
# is the same geometry GLM's is (hc_mult 4, hc_sinkhorn_iters 20, hc_eps 1e-6,
# hidden 4096) behind an identical wrapper signature, so dsv4_mhc_tilelang
# carries the same hook GLM's does. The other three do not apply:
#   MK_SEG_KDA  -- no linear-attention layer exists in this model
#   MK_SEG_MLA  -- GLM's kernel is NoPE/topk-2048; this model has rope 64,
#                  topk 512, a compressor and a sliding window
#   MK_SEG_GEMM -- the lane is W4 (e2m1 packs); this checkpoint's dense
#                  weights are block-fp8 and have no bf16 source to repack
# They compile into the extension and are never launched.
#
# The window is small even for MHC, and it is the WRAPPER's rather than the
# kernel's: the hook sits inside `use_small_fma` (T <= 16) while the kernel
# gates at T <= 32. At SPEC_TOKENS=5 a step carries C x 6 tokens, so only
# C <= 2 is ever offered to it; 16 < T <= 32 takes the stock post+big_fuse
# branch and production C=32 (M=192) is nowhere near. The C=1/2/4 bracket
# straddles that boundary -- C=1/2 hit the hook, C=4 does not.
#
# One precondition the knobs cannot express: the MHC wrapper this hooks is
# reached only while VLLM_USE_B12X_MHC is off (model.py's _should_run_b12x_mhc
# returns from the cute path first). That knob is unavailable on this fleet
# today -- if it ever comes back, the megakernel hook goes unreachable while
# the boot log still says the segment armed.
#
# NOTHING is measured on this model yet, and this is production: the MK pair
# is a reduce-order change (rel 1e-3 class), not bit-exact. Ladder before any
# arm: probes/run_megakernel_bench.sh in a FRESH container on this image
# (numerics + timing vs THIS image's stock pair), then quality 9/9 + the
# ordinary C=1/2/4 bracket. Arming without that is arming on GLM's numbers.
#
# Arm for one run through the caller environment, never EXTRA_ENV (these are
# profile-declared keys, and the launcher now aborts on that):
#   VLLM_GLM53_MEGAKERNEL=1 VLLM_GLM53_MK_MHC=1 bash launchers/start-hy4-tp4.sh
VLLM_GLM53_MEGAKERNEL=0
VLLM_GLM53_MK_MHC=0
# Programmatic dependent launches. Off until the segment above is measured;
# nvcc 13.2 is in this image (ledger 08-08) and osar already builds a .cu here,
# so the toolchain is not the open question -- the numbers are.
VLLM_GLM53_MK_PDL=0

# --- production serving knobs (entry-point unification, 2026-09-04) ----------
# srv2 ran a 481-line fork of the launcher (~/start-hy4-tp4.sh, 08-30) while the
# repo copy was refactored to 655 lines. Unifying on the repo copy would have
# silently dropped the values below, each of which the fork was passing. They
# live here now so the launcher has one home for them and the fork can become a
# thin wrapper. tests/test_logic.py holds this set against the fork.

# GPU_MEM is PINNED here on purpose. _GPU_MEM_PINNED is recorded after this
# profile loads, so setting it stops the memfree preflight from raising it --
# and raising is what it would do: at margin 10 a clean node measures ~0.744
# against this 0.60, which trades ~38 GiB of host headroom for KV cache. That
# may well be the right trade now that earlyoom actually fires (floor 6 GiB,
# watermark 4 GiB), but it is a serving change and nothing has measured it.
# Unpinning is this one line, after a bracket A/B lands in MEASUREMENTS.md.
GPU_MEM=0.60

# --long-prefill-token-threshold. Dropping the flag hands long prefills back to
# the default scheduler path.
LONG_PREFILL=2048

# "dspark" needs no draft model. Any other value is a draft-model method and
# reads DRAFT_PATH/DRAFT_KV/DRAFT_BLOCK from the caller.
SPEC_METHOD=dspark

# Interactive reserve: 0 = no decode slots held back from bulk prefill.
VLLM_INTERACTIVE_RESERVE=0
VLLM_INTERACTIVE_BULK_CHUNK=1024

# DSpark confidence scheduler -- off/neutral in production. Declared so the
# knobs have a home and a documented default rather than vanishing with the fork.
VLLM_DSPARK_CONFIDENCE_SCHEDULER=off
VLLM_DSPARK_CONFIDENCE_THRESHOLD=0.0
VLLM_DSPARK_TOPK_GATHER=0
