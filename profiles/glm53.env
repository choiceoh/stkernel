# GLM-5.3-Flash NVFP4 -- 4x DGX Spark GB10, TP=4.
#
# STATE: bring-up, blocked. b12x serves (ko 26.3 / code 83.1 tok/s) once the two
# modules below are mounted, but output shows intermittent corruption of
# individual Korean tokens. Operator reading: image-side. Not diagnosed.
# Isolate before trusting any number from this profile:
#   DECIDE_SPEC=0  -> speculative decoding off. If the corruption survives, it is
#                     not DFlash2 verification and the search moves to the image
#                     (tokenizer/detokenizer, checkpoint quantization).
PROFILE_DESC="GLM-5.3-Flash NVFP4 TP=4 (bring-up, Korean-token corruption open)"
PROFILE_IMAGE="glm53:v13-b12x"
# RedHatAI's NVFP4, not LibertAIDAI's. Both quantize zai-org/GLM-5.3-Flash;
# only the LibertAIDAI one corrupts Korean. Measured on this stack, same image,
# same overlays, same graphs, same knobs, same probe, same nodes -- weights the
# only difference:
#
#   LibertAIDAI (modelopt)        722.7 / 754.2 / 785.4 / 1135.3 / 1173.1 per M
#   RedHatAI (compressed-tensors)   0.0 per million over 38,178 chars
#
# At the LibertAIDAI rate that corpus predicts ~30 corruptions. Zero appeared.
# The same model served by z.ai is also clean, so NVFP4 is not the problem --
# that one build is.
PROFILE_MODEL_PATH="/home/choiceoh/models/glm53-redhat-nvfp4"
PROFILE_SERVED_NAME="glm-5.3-flash"
PROFILE_LAUNCHER="start-glm53-nvfp4-tp4.sh"

# This image installs to dist-packages, not the venv site-packages the DSV4 image
# uses, and one module targets flashinfer rather than vllm -- so the DSV4 modules
# cannot be mounted here and the allowlist has to come from the profile.
PROFILE_OVERLAY_DIR="/home/choiceoh/overlays/glm53"
TARGET_PREFIX="/usr/local/lib/python3.12/dist-packages/"

# moe_gate_sm121 is the same kernel DSV4 runs: GLM builds its router through
# GateLinear too (glm5next/nvidia/model.py:183), its 288 experts are a
# multiple of the kernel's BLOCK_N and its 4096 hidden a multiple of
# SPLIT_K*BLOCK_K, so the fused tier's own guards admit it. glm53_model_wiring
# is just the construction site.
# b12x_swiglu_clamp and flashinfer_b12x_collapse are NOT here: their fixes
# were baked into the image at v11, and their sources are pinned against v9.
# Two of their three files are byte-identical to what v13 ships and the third
# would drop thirty lines v13 has. They remain in overlay/modules for a v9 image.
MODULES="glm53_tail_slot_persistent glm53_kpool_tail_select glm53_drop_audit moe_gate_sm121 glm53_model_wiring tp_oneshot_ar glm53_oneshot_wiring fp8_lm_head glm53_dflash2_fp8_head glm53_dflash_loader_fp8"

# --- serving knobs -----------------------------------------------------------
# b12x, never marlin: naming the backend makes an unsupported config raise, while
# auto quietly falls back to a path that dequantizes FP4 to bf16.
# The kernel family is the same; the name is not. DSV4 serves mxfp4 and calls
# it `b12x`, this image serves nvfp4 and calls it `flashinfer_b12x`.
MOE_BACKEND="flashinfer_b12x"
# Arms the fused gate. VLLM_DSV4_GATE_FUSED still works; this is the neutral
# name for a module that is not DSV4's.
# These three read 1 from the day they were written and never reached a
# container -- the launcher did not pass profile env, so every module they gate
# ran its stock path. The plumbing carries them now and the operator's call is
# to arm them, so the next boot is the first time any of these executes on this
# model. If a corruption number moves after that boot, the cause is not
# attributable to one of them from that run alone -- isolate by taking them
# down one at a time (VLLM_MOE_GATE_FUSED=0 ./start... for a single run).
VLLM_MOE_GATE_FUSED=1
# fp8 draft head (deepgemm W8A16) -- the variant adopted on this fleet, not
# the rowwise _scaled_mm one that was measured and rejected.
VLLM_SPEC_FP8_LM_HEAD=1
# Target head fp8 halves 0.32 GB/rank/step; the same knob measured C=1 +2.7%
# on DSV4. Armed by operator decision.
#
# What that decision accepts: the target's logits pick the sampled token and
# the accept/reject, so unlike the draft head they are outside what rejection
# sampling guarantees -- a quantization error here changes output rather than
# just acceptance. DSV4 adopted it behind a greedy-divergence gate; GLM has no
# such gate yet, and its Korean-token corruption is still unexplained, so an
# isolation run wanting a clean single variable should set this back to 0
# alongside DECIDE_SPEC=0.
VLLM_TARGET_LM_HEAD_FP8=1
# The drafter's block is 8; 7 is that minus the verified token. The launcher's
# default of 4 contradicts its own comment.
SPEC_K=7
# Drafter on rank 0 only: no per-draft collectives, no sharded draft KV.
DRAFT_TP=1
# Draft KV stays bf16 while the target keeps fp8_ds_mla, and the draft attention
# backend is left unpinned (SM121 picks FLASH_ATTN; TRITON_ATTN is a known trap).
DRAFT_KV="auto"
# --- memory budget (measured 2026-08-30, TP=4, GRAPH_CAP=16) ------------------
# Weights + activations take ~78 GiB per rank, so GMU has to clear that before
# there is any KV at all:
#
#   GMU 0.60 (71.8 GiB)  ->  Available KV cache memory: -5.67 GiB
#   GMU 0.65 (77.8 GiB)  ->  Available KV cache memory: -2.06 GiB
#
# The KV number gets *worse* as GMU comes down, which reads like the opposite of
# what it is: backing off after an OOM is the wrong reflex here. CUDA graphs are
# not the problem either -- at GRAPH_CAP=16 they cost 1.10 GiB.
#
# The other half is that free memory measured before launch is not the free
# memory the engine sees: `docker run` pulls the ~31 GB image through the page
# cache first, and ~11 GiB is gone by the startup check (101.6 -> 90.19,
# 102.6 -> 90.49, 113 -> 90.5 on three attempts). So:
#
#   GMU = (min MemFree across nodes - 11 - margin) / 119.69
#
# launchers/memfree-preflight.sh does that, and also kills the idle Gradle
# daemons that otherwise sit on ~10 GiB of whichever node last built the Android
# client. They do not show up in `docker stats`; the tell is AnonPages, 22.6 GiB
# on that node against 2.2 on its peers.
GMU_NOTE="weights+act ~78 GiB/rank; raise GMU, do not lower it"
GMU=0.73                # measured floor; 0.85 does not boot
EAGER=0                 # graphs on -- eager was rejected on speed
# max_num_seqs * (1 + num_spec) = 4 * 8 = 32 is the largest uniform-decode
# batch, and at 16 the 24- and 32-token verify steps had no graph at all --
# C=4 measured 45.0 tok/s against C=2's 43.6, which is no scaling. The whole
# capture costs 0.22 GiB, not the 1.10 this comment used to claim.
GRAPH_CAP=32
KV_DTYPE=fp8_e4m3       # auto = bf16, for isolating KV quantization
MAX_SEQS=4
MAX_BATCHED=2048
MAX_LEN=1048576

# LM head rows the tokenizer cannot decode (154856..154879 here) are live
# argmax candidates: config vocab_size sets both the head width and
# org_vocab_size, so vLLM's logits slice is a no-op. glm5next_model masks them.
# Empty = read the bound from the tokenizer (the right default; a literal goes
# quietly wrong the day the model changes).
VLLM_GLM53_DECODABLE_VOCAB=
# 1 = also count how often a masked row was about to win, logged every 256
# calls. Two vocab reductions per step plus one sync per 256; off by default.
VLLM_GLM53_VOCAB_MASK_AUDIT=0
