# GLM-5.3-Flash NVFP4 -- 4x DGX Spark GB10, TP=4. Bring-up, not production.
#
# Runs on stock image code. The two repairs the bring-up needed -- flashinfer
# 0.6.18's _collapse_to_vmk lender gap and the b12x SwiGLU clamp -- are recorded
# in MEASUREMENTS.md and deliberately not modules: production is on 0.6.17,
# where the lender gap does not exist, so shipping a module for it would carry
# a fix for a bug this fleet does not have.
PROFILE_DESC="GLM-5.3-Flash NVFP4 TP=4 (bring-up)"
PROFILE_IMAGE=""
PROFILE_MODEL_PATH="/home/choiceoh/models/glm53-flash-nvfp4"
PROFILE_SERVED_NAME="glm-5.3-flash"
PROFILE_LAUNCHER="start-glm53-nvfp4-tp4.sh"

MODULES="tp_oneshot_ar"
