# GLM-5.3-Flash NVFP4 -- 4x DGX Spark GB10, TP=4.
#
# STATE: bring-up, blocked. b12x serves (ko 26.3 / code 83.1 tok/s) once the two
# modules below are mounted, but output shows intermittent corruption of
# individual Korean tokens. Operator reading: image-side. Not diagnosed.
# Isolate before trusting any number from this profile:
#   DECIDE_SPEC=0  -> speculative decoding off. If the corruption survives, it is
#                     not DFlash2 verification and the search moves to the image
#                     (tokenizer/detokenizer, checkpoint quantization).
PROFILE_DESC="GLM-5.3-Flash NVFP4 TP=4 (bring-up, Korean-token corruption open)"
# glm53:v13-b12x plus one layer: `pip install instanttensor`. The base
# image has no such loader, and pointing at it while LOAD_FORMAT said
# instanttensor killed a boot 75 s in. Overlay preimages are unaffected
# (20/20 verified against this tag) -- the added package touches
# instanttensor/ and nvidia/nccl/, neither of which any overlay
# replaces -- and torch still links NCCL 2.29.7, the version the fleet
# was already running. Rollback: PROFILE_IMAGE="glm53:v13-b12x" plus
# LOAD_FORMAT=auto.
PROFILE_IMAGE="glm53:v13-b12x-it"
# RedHatAI's NVFP4, not LibertAIDAI's. Both quantize zai-org/GLM-5.3-Flash;
# only the LibertAIDAI one corrupts Korean. Measured on this stack, same image,
# same overlays, same graphs, same knobs, same probe, same nodes -- weights the
# only difference:
#
#   LibertAIDAI (modelopt)        722.7 / 754.2 / 785.4 / 1135.3 / 1173.1 per M
#   RedHatAI (compressed-tensors)   0.0 per million over 38,178 chars
#
# At the LibertAIDAI rate that corpus predicts ~30 corruptions. Zero appeared.
# The same model served by z.ai is also clean, so NVFP4 is not the problem --
# that one build is.
PROFILE_MODEL_PATH="/home/choiceoh/models/glm53-redhat-nvfp4"
PROFILE_SERVED_NAME="glm-5.3-flash"
PROFILE_LAUNCHER="start-glm53-nvfp4-tp4.sh"

# This image installs to dist-packages, not the venv site-packages the DSV4 image
# uses, and one module targets flashinfer rather than vllm -- so the DSV4 modules
# cannot be mounted here and the allowlist has to come from the profile.
PROFILE_OVERLAY_DIR="/home/choiceoh/overlays/glm53"
TARGET_PREFIX="/usr/local/lib/python3.12/dist-packages/"

# moe_gate_sm121 is the same kernel DSV4 runs: GLM builds its router through
# GateLinear too (glm5next/nvidia/model.py:183), its 288 experts are a
# multiple of the kernel's BLOCK_N and its 4096 hidden a multiple of
# SPLIT_K*BLOCK_K, so the fused tier's own guards admit it. glm53_model_wiring
# is just the construction site.
# b12x_swiglu_clamp and flashinfer_b12x_collapse are gone (2026-09-03). Their
# fixes were baked into the image at v11 and their sources were pinned against
# v9, so they were kept "for a v9 image" -- but nothing in this repo can launch
# one: every profile and the launcher's own default name v13-b12x, and all
# three of their files fail the preimage check against v13, so
# deploy-overlays.sh would refuse to mount them anyway. A module that cannot
# be mounted on any image the repo can start is not a rollback path. A real v9
# rollback means checking out a commit from that era, where the whole tree
# agrees; git still has them.
# glm53_mhc_tilelang mounts the env-tunable small-M override for the MHC
# TileLang decode dispatcher (STEP_KERNEL_MAP #108 #4, 185 kernels/step). Its
# knob VLLM_GLM53_MHC_SMALLM is deliberately UNSET here -- unset means the
# stock heuristic byte-for-byte, so mounting is inert until the sweep probe
# (probes/mhc_glm53_bench.py) finds a winner and a bracket adopts it.
# The image runs V2 Model Runner. The V1-only glm53_drop_audit / glm53_sparse_q
# overlays were deleted in 34차 §8 (never mounted here: they advertised guards
# and sparse-q behavior the live DFlash2 path never executed).
# 34차 (2026-09-05, 운영자 "디폴트화된 모듈들을 4~5개씩 하나로 묶어라"): the 25
# glm53-only modules folded into five grouped modules. Rows, files, knobs
# and defaults are unchanged (the composed build/glm53 is byte-identical but for
# one comment line in glm53_megakernel.cu; only the manifest row order moved); the group READMEs keep one section per old
# module, and the knob comments below still name the old module they came from.
#   glm53_model   = glm53_model_wiring + glm53_indexer_gate_splitk + glm53_mk_kda_wiring
#                   + glm53_mk_mla_wiring + glm53_kda_onepass + glm53_fp8_dense
#   glm53_kernels = glm53_kpool_tail_select + glm53_tail_slot_persistent
#                   + glm53_sm121_mla_prefill + glm53_kda_prefill_regime + glm53_mhc_tilelang
#   glm53_drafter = glm53_dflash2_fp8_head + glm53_dflash_loader_fp8 + glm53_dflash_warmup
#                   + glm53_dflash_early_fc + glm53_drafter_prep + fp8_lm_head
#   glm53_moe     = b12x_shared_workspace + b12x_zero_weight_micro + glm53_b12x_out
#   glm53_runtime = glm53_prep_fused + glm53_v2_sampler_guards + glm53_boot_stamps
#                   + glm53_dev_lab + glm53_oneshot_wiring
# moe_gate_sm121, tp_oneshot_ar and glm53_megakernel are shared with dsv4 and stay.
MODULES="moe_gate_sm121 tp_oneshot_ar glm53_megakernel glm53_kernels glm53_moe glm53_model glm53_drafter glm53_runtime"

# --- serving knobs -----------------------------------------------------------
# Dense-MHA for GLM's short/full-attention sparse-MLA prefill region on SM121.
# The module admits only the current SM90/HND fp8_e4m3 backend and exact GLM-5.3
# geometry; every mismatch keeps the existing top-k MQA path. Default off until
# the engine-down fresh/prefix-cache bracket in the module README is clean.
VLLM_GLM53_SM121_MLA_PREFILL=0
# Fuse the BF16 K and pool-gate projections in sparse prefill, mixed batches,
# and decode. The FP32 head-weight projection and ranking path are unchanged.
VLLM_GLM53_FUSED_K_GATE=0
# Warm the real aligned and sliced-pointer Triton launch keys for the pooled
# sparse-prefill metadata builder. This changes startup only, not numerics.
VLLM_GLM53_PREFILL_METADATA_WARMUP=1
# Fixed GLM KPool CUDA radix select + pool expansion + live-tail append.
# Exact opt-in; build or launch failures use the existing vLLM implementation.
VLLM_GLM53_KPOOL_FUSED_TOPK=0
# Split the actual generic-FLA KDA chunk Autotuners into stock/short and long
# packed-prefill caches. Exact 1 only; every production-contract mismatch and
# packed average below 1024 stays on stock regime 0. The boundary has no fleet
# performance result yet, so regime splitting remains disabled by default.
# The mounted source still changes the Triton ABI/key schema, so a fresh image
# must recompile and autotune the stock bucket even while this value is 0.
VLLM_GLM53_KDA_PREFILL_REGIME=0
# glm53_fp8_dense (above): fp8 block copies of the bf16 dense projections.
# On by default. The dense projections are 15.44 GiB of bf16 read whole by
# every rank every forward -- about 17 ms/step in the trace's cutlass_80_wmma
# block -- and dsv4 already runs its whole model in this same block-fp8 scheme
# on this fleet at 78.5 pct acceptance. That makes arming it convergence on a
# configuration this hardware has already sustained, not a new experiment.
#
# Rollback is this one line (or VLLM_GLM53_FP8_DENSE=0 for a single run), and
# the module falls back to bf16 per layer if a quantize guard or an apply call
# raises, so a bad layer degrades instead of failing the boot.
#
# The arm is visible in the boot log as "[fp8-dense] N linears ...". The gates
# it must hold -- 9/9 retrieval, 0/16 Korean, pos-1 acceptance within 2 pct of
# control, C=1/2/4 bracket -- are numerics gates, and this changes numerics on
# attention and MLP matmuls, which is the same axis that produced the Korean
# corruption of 2026-08. Run them on the next boot and revert this line if any
# of them moves.
# w4a8 (experimental arm, NOT a default): weights a notch lower on
# fp8_fp4_gemm_nt, activations stay fp8. It was shipped as the default and
# **that killed the boot** (2026-08-31):
#
#   08:08:06  [fp8-dense] knob=w4a8: 0 linears w4a8, 180 w8a8, 0 disarmed
#   08:12:46  torch.AcceleratorError: CUDA error: unspecified launch failure
#             load_model -> DeviceMemoryProfiler.__exit__ -> empty_cache()
#
# The fallback ladder is not a safety net here. The build-time probe launches
# a REAL kernel, and an invalid launch raises ASYNCHRONOUSLY -- the try/except
# around it returns cleanly (hence "0 linears w4a8, 0 disarmed", which reads
# like a healthy fallback) while the CUDA context is already poisoned. The
# boot then dies four minutes later at the next sync point, with a traceback
# that points at empty_cache and names nothing about fp8-dense.
#
# A python-level fallback cannot contain a CUDA launch failure. Until the
# probe runs somewhere a failure is recoverable -- a child process, or a
# capability check that does not launch -- w4a8 stays opt-in.
VLLM_GLM53_FP8_DENSE=1
# EXP-4 (runbook): the low-rank b projections (MLA q_b_proj, kv_b_proj) and the
# indexer's wq_b join the fp8-dense pattern set -- and, with MK_GEMM=1, get the
# megakernel's W4 pack and the v2 lane like every other decode linear. Declared
# here (off) so an arm can set it: the launcher forwards profile-declared
# VLLM_* keys only. Census (ledger 30차 §14): q_b + wq_b are 22 bf16 launches,
# 1.48 ms/step, W4 -> ~0.35 ms.
VLLM_GLM53_FP8_DENSE_BPROJ=0
# Lever 7 (28차): the nvfp4 pair as a PREFILL route on every fp8 dense
# linear -- rows above the MK lane's M=32 take mm_fp4 (2.3x the fp8 GEMM at
# prefill shapes, half the weight bytes; +~1 GB/rank of copies), decode keeps
# the W4 lane. A4 activations: served-numerics change, bracket-gated (quality
# 9/9, Korean 0/16, acceptance profile, prefill ladder). Exact "1" arms; the
# boot log counts "N nvfp4 prefill pairs". Pass as caller env.
VLLM_GLM53_FP8_DENSE_PREFILL_NVFP4=0
# Release the bf16 source of every quantised dense linear once the fp8 copy is
# in place: 2.94 GB/rank at TP4, straight to the KV cache (fp8 pack 1.47 GB and
# the megakernel's W4 pack 0.82 GB are the copies that are actually read). It
# also removes the bias and exception fallbacks through the bf16 path -- no
# admitted linear has a bias here, and the error path is the same trade the
# megakernel segments make. Not recoverable at runtime.
#   ON by default since 2026-09-04. It was opt-in for the runtime-recovery
#   argument, but the memory it holds is not spare: with it OFF the fleet
#   boots with ~3 GB free of 121 GB, and at that margin the HOST goes down --
#   srv3 was OOM-killed on 09-03 and srv1/srv2 wedged on 09-04 (sshd could
#   not fork a session; only a power cycle or a broken collective got them
#   back). A knob whose default costs a node is not a safe default.
VLLM_GLM53_FP8_DENSE_FREE_BF16=1
# The DFlash2 drafter's own dense projections: fp8 block copies and, with
# MK-GEMM armed, the same W4 packs behind them (the drafter's forward is
# torch.compiled, so its GEMMs go through one opaque op that picks MK or
# fp8 at run time -- glm53_fp8_dense._mk_or_fp8_dense_gemm). Covers all 31
# drafter linears: qkv_proj, o_proj, gate_up/down, both conv
# kernel_projections and the K=20480 fc (five K-chunked MK launches).
# ON by default since 2026-09-04 (bracket, MEASUREMENTS 27차): the drafter's
# bf16 GEMMs were 3.2-3.6 ms of every decode step's tail, and the W4 lane
# takes them to ~1.25 ms at the fleet shapes with acceptance inside the
# gate. Rollback = 0 for a boot. There is no fp8-only value any more: a
# proven improvement is the default here, not one of two settings.
VLLM_DFLASH2_FP8_DENSE=1
# b12x MoE write-back: the kernel scatters straight into the caller's buffer
# instead of static workspace + copy (glm53_b12x_out takes over flashinfer's
# wrapper for this). Second write of the same bytes per layer, gone.
# Rollback = this one line.
VLLM_B12X_DIRECT_OUT=1
# glm53_megakernel: persistent 48-block decode segments (MHC fused post+pre,
# W8A8 quant+GEMM, the whole KDA block). MHC, GEMM and MLA default ON since
# 28차 (2026-09-04, operator: the bracketed set is the production default;
# C=1 step/s 16.4, 23K prefill 2,700 tok/s, quality 9/9, Korean 0/16);
# each segment still arms only after its boot self-test diffs it against
# the stock path, and KDA stays off (never served: layout gate + open
# state-index contract). Rollback = VLLM_GLM53_MEGAKERNEL=0. Expected value is the launch/glue share of the 25 ms non-expert
# budget -- a CEILING of ~4.9 ms/step, unmeasured until the EXP-5 bracket
# runs. MK-GEMM duplicates the fp8 weight bytes (~+4 GB/rank); watch the KV
# line on its first boot. MK-KDA has an open state-index contract: run
# _KDA_SHADOW on a bench boot before arming it.
#   MK-KDA also needs VLLM_SSM_CONV_STATE_LAYOUT=DS -- it indexes the conv
#   state as (dim, state_len) and vLLM defaults to SD, under which the
#   segment's layout gate rejects every layer for the whole boot. The
#   launcher derives that env from this knob; do not declare it here, or
#   EXTRA_ENV can no longer move it.
VLLM_GLM53_MEGAKERNEL=1
VLLM_GLM53_MK_MHC=1
VLLM_GLM53_MK_GEMM=1
# 32차 §14 (operator): the zero-gain set without SMLP -- KDA + AR prefetch (+ LOCALQ, sunset 34차 §8) --
# adopted on the v2 default after a full-leg arm with Korean 0/16 (+0.7% together).
VLLM_GLM53_MK_KDA=0
VLLM_GLM53_MK_KDA_SHADOW=0
# Programmatic dependent launch for every MK launch: the next MK kernel
# starts on the SMs this one frees and pulls its first W tiles during its
# tail (17-19 pct less per launch back to back, MEASUREMENTS 2차). Serving
# never carried it: the driver reads this env, the bench probe sets it, and
# neither this profile nor ab-glm53.sh did -- every armed boot to date ran
# the lane without PDL. Numerics are unchanged (each kernel
# griddepcontrol.waits before its first read of the previous output; the
# pre-wait fill is weights only) and the captured-chain form is checked by
# probes/mk_pdl_graph_check.py. Inert while no segment is armed.
VLLM_GLM53_MK_PDL=1
# 30차 v2 non-resident GEMM lane (mk_gemm2_kernel): standalone -2..-7 us on
# most shapes; the served step is the judge (32차 chain 14). Declared so a
# caller env reaches the container. DEFAULT ON since 32차 (chain 14-16): served
# step windows +2.8% median across three boots, full legs clean.
VLLM_GLM53_MK_GEMM2=1
# 33차 (operator: "accuracy up, speed untouched"): pack-time levers of the W4
# GEMM lane -- same bytes, same kernel. ROWSHIFT: the shift that keeps the
# group exponents inside the expansion window is per row (undone on the
# output column). GPTQ: error-feedback rounding when a calibration boot
# (MK_CALIB=1, dumps <MK_CALIB_DIR>/rank<r>/<linear>.pt after MK_CALIB_TOKENS
# rows) has left this rank's input Hessians; RTN otherwise. LORC: rank of the
# activation-aware low-rank correction the v2 kernel adds in its epilogue
# (0 = off; 8..32, multiples of 8). Packs are cached under MK_PACK_CACHE by
# weight md5 + levers + pack version. The activation scale is exact
# (amax/448) unconditionally.
VLLM_GLM53_MK_PACK_ROWSHIFT=1
VLLM_GLM53_MK_PACK_GPTQ=1
VLLM_GLM53_MK_PACK_LORC=0
VLLM_GLM53_MK_PACK_CACHE=/cache/mkpacks
VLLM_GLM53_MK_CALIB=0
VLLM_GLM53_MK_CALIB_TOKENS=32768
VLLM_GLM53_MK_CALIB_DIR=/cache/mkcalib
# tp_oneshot_ar: while a collective waits for its peers (38.7 of 45.5 us,
# ~100 per step, DRAM idle), warm the next kernel's weights into L2. What
# to warm is learned from the megakernel launches that follow each
# collective in the eager warmups, so this needs MK-GEMM armed to have
# anything to learn. 0 = off (kernel byte-identical), 1 = 12 MB per
# collective, N = N MB (1..20). Speed only; ceiling ~2-3 pct/step
# (strategy doc 2026-09-04), bracket on the fleet like any arm.
VLLM_GLM53_AR_PREFETCH=0
# glm53_dflash_early_fc: the drafter's fc (aux hidden -> 4096; 301 us on the
# lane) runs on a side stream under the target head + AllGather + sampler
# instead of after them. Same kernel, same inputs -> identical bytes; speed
# only, ceiling ~0.3 ms/step, matters when EXP-10 puts the fc on the lane.
# Exact 1 arms; the producer disables itself for the boot on any failure.
VLLM_GLM53_DFLASH_EARLY_FC=0
# glm53_drafter_prep (34차, EXP-24): the drafter's per-step host build of its
# attention metadata is skipped when the drafter step is a FULL cudagraph
# replay -- propose() never reads that dict on the FULL branch, but building
# it costs a pageable DtoH + stream sync and 300-460 us of Python while the
# GPU idles (trace: rank 0 420 us, rank 3 640 us per step, and rank 3's
# slower host holds every rank at the drafter's first all-reduce). Modes:
# time (stock, host us logged) / shadow (stock served, cached dict compared,
# drift logged) / 1 (cached per shape, build skipped). Bytes and graph are
# untouched: speed only, bracket on C=1 step/s with prefill alongside.
VLLM_GLM53_DRAFTER_PREP=0
# 34차 EXP-24 item 6: the drafter's context K/V projection (one fused bf16 GEMM
# over the five layers' k/v rows, 21 MB, 101 us/step -- the last drafter linear
# outside the W4 lane) on the MK W4 lane for decode-sized batches. Drafter
# numerics only (its query-path k/v already serve from the same kind of pack);
# gate = acceptance profile +/-2 pct + quality + Korean. Exact 1 arms.
VLLM_GLM53_DRAFTER_CTX_KV_W4=0
# glm53_kpool_tail_select (34차, EXP-24): the sparse indexer's decode top-k
# glue -- token seq_len from positions, the "force the last completed pool"
# scatter, and the copy of the expanded indices into the persistent buffer
# -- as ONE Triton launch per full-attention layer instead of eleven aten
# kernels (11 layers x ~24 us/step). Integer index arithmetic only: bit-exact
# with the stock chain by construction (probes/indexer_decode_fused_check.py).
# Exact 1 arms (uniform spec-verify decode only; padded batches stay stock).
VLLM_GLM53_INDEXER_DECODE_FUSED=0
# MK_SEG_MLA: our own sparse MLA decode kernel (bf16 mma; see the segment
# comment in glm53_megakernel.cu). glm53_mk_mla_wiring routes decode AND
# prefill rows to it (v5). Default 1 within the megakernel set since 28차
# (2026-09-04): with the fixed split scratch (the grow-on-demand one freed
# its tensors under the captured decode graphs -- two serving deaths) the
# MLA-on arm passed the whole bracket twice: C=1 step/s 16.4 vs 16.235 off,
# 23K prefill 2,700 vs 2,300 tok/s (+17%, TTFT 10.0 -> 8.5 s), quality
# 9/9, Korean 0/16, pos-1 67.0% vs 64.5%. Only meaningful with
# VLLM_GLM53_MEGAKERNEL=1 (the master gate); rollback = this one line.
VLLM_GLM53_MK_MLA=1
# MK-GEMM v2 (30차): the standalone decode GEMMs as a NON-persistent grid --
# no grid barrier, two blocks per SM, so the shared expert's side-stream pair
# shares SMs with the routed MoE kernel instead of queueing behind it. Off
# until its bracket (RUNBOOK EXP-21); 1 = every eligible decode linear.
# (duplicate VLLM_GLM53_MK_GEMM2 declaration removed 32차: the default is set once above, =1)
# MK_SEG_SMLP2: the dense/shared-expert MLP as two PDL-chained v2 launches
# (gate_up pair-activation epilogue -> fp8 groups -> down on a_ready), no
# barrier. Needs the W4 packs (MK_GEMM or MK_SMLP2 builds them). Off until
# bracketed. (The one-launch persistent MK_SMLP was sunset in 34차 §8.)
VLLM_GLM53_MK_SMLP2=0
# 32차 item 5: the dev lab (glm53_dev_lab) -- POST /glm53/lab replays the
# served decode graph, hot-reloads the megakernel extension and recaptures,
# so a kernel change is timed in ~1-2 minutes instead of a bracket boot.
# DEV BOOTS ONLY (replay overwrites the last batch's state slots).
VLLM_GLM53_DEV_LAB=0
# glm53_prep_fused: the decode step's host-side input preparation (prepare_
# inputs + prepare_attn + the 7 KV-group metadata builders: ~1,000 aten calls,
# ~45 memcpys, ~100 tiny launches per step) replaced by one H2D copy + one
# Triton launch + the deep_gemm schedule, for uniform spec-verify steps on a
# FULL cudagraph. With DFlash the scheduler is synchronous, so that host time
# is GPU idle: 5.7 ms of a 72 ms profiled step (2026-09-01 trace), ~4-5 ms
# without the profiler. Bit-exact with the stock buffers by contract.
#   shadow -> fused first, then the whole stock chain over the same buffers,
#             diff logged; clean -> the fused batch serves the step (bench boot
#             first, must be DRIFT-free)
#   1      -> armed; re-verifies every 64 fused steps and DISARMs on drift
#             (VLLM_GLM53_PREP_FUSED_SELFCHECK_EVERY)
# Unknown values DISARM. The installer pins the runner/builder preimages
# (DISARM on drift). Pass overrides as caller env (profile-declared key). EXP-7.
# 32차 (2026-09-05 00:45, 운영자 "프렙퓨즈드 1해"): DEFAULT ON. EXP-7 measured
# +7.3% (PREP 17.59 vs 16.39) and the hang that killed PREP2 also killed
# PREP3 (split-K only) and NVFP4P2 (nvfp4 prefill only) with the same
# signature, so it is not this knob's; the stall reporter on srv2 dumps
# every rank if a boot stalls, and 0 stays the kill switch.
VLLM_GLM53_PREP_FUSED=1
# Async scheduling is ALREADY ON for dflash in this image: `dflash` is a
# member of EagleModelTypes (config/speculative.py), so the disable branch
# in config/vllm.py short-circuits and the chain falls through to
# `async_scheduling = True`. Nothing to arm; the glm53_async_dflash module
# that used to sit here was dead code (2026-09-03 boot, MEASUREMENTS).

# glm53_indexer_gate_splitk: the indexer's fp32 head gate ([M,4096]x[4096,32])
# as a deterministic split-K Triton path for M<=16 (decode); larger M and
# prefill keep torch.mm. fp32 either way, summation order differs -> served
# numerics change: quality 9/9 + Korean 0/16 + pos-1 acceptance +/-2pct. Exact
# "1" arms; the boot log shows "[indexer-gate] ... -> split-K" (a "shape not
# admitted" line means stock). Numbers: the module README. EXP-9, rides the
# EXP-7 boot. Pass as caller env (profile-declared key; EXTRA_ENV refuses it).
VLLM_GLM53_INDEXER_GATE_SPLITK=0

# --- launch-count bundle 2 (2026-09-04, "small gains bundle", EXP-20) -------
# Three self-owned micro-fusions, each below the bracket's resolution alone
# (0.015-0.15 ms of a ~65 ms step) and adopted as ONE bundle on the R2 rule:
# offline numerics gate + in-graph physical confirmation (the kernels are
# gone from the trace) + e2e no-regression. All default 0 = stock. Arm all
# three together as caller env for the bracket boot; the probe
# (probes/run_micro_fusion_check.sh) is the offline gate. A fourth axis, the
# router top-k as an epilogue of the fused gate, was bit-exact but slower
# than the kernel it replaced and is not in the tree (MEASUREMENTS 31차).
#
# glm53_kda_onepass: f_b + g_b as one dual GEMM per KDA layer (34 launches
# instead of 68; fp32-accumulated bf16 GEMM either way -- the probe reports
# whether cuBLAS' K=128 accumulation is matched bit for bit).
VLLM_GLM53_KDA_DUAL_GEMM=0
# glm53_kda_onepass: conv + q/k/v/beta copies + recurrence + gated norm as
# ONE launch per KDA layer on pure spec-verify steps (7 -> 1, -204/step).
# Conv state, recurrent state and output bit-identical to the stock chain on
# the probe's fleet-shape cases, both cache dtypes (the norm's reduction tree
# is not the stock kernel's, so the class stays declared reduce-order) ->
# quality 9/9 + Korean 0/16 + acceptance profile on the bundle boot. The
# module self-tests against the stock chain on the first eager forward and
# DISARMs on any mismatch ("[kda-onepass] self-test ..." in the boot log).
VLLM_GLM53_KDA_ONEPASS=0
# glm53_kpool_tail_select: the kpool update kernel reads the runner's int64
# positions directly (drops the int32 cast copy before each of the 11
# `_kpool_decode_update_batched_kernel` launches). Bit-identical writes.
VLLM_GLM53_KPOOL_UPDATE_DIRECT_POS=0

# Exact-shape GLM TP MoE tuning controls. Empty means the shipped automatic
# dispatcher and MAC ladders; the launcher does not pass empty values into the
# container. These are experiment inputs only -- no winner has been measured.
# FORCE_BACKEND: auto|micro|static|dynamic (micro applies only to M<=8).
# CUTOVER: routed-pair count; 0 sends every exact GLM call to dynamic.
# *_MAC_LADDER: comma-separated max_rows:mac cells, e.g. "64:48,128:48".
VLLM_GLM53_B12X_FORCE_BACKEND=""
VLLM_GLM53_B12X_STATIC_CUTOVER_PAIRS=""
VLLM_GLM53_B12X_MICRO_MAC_LADDER=""
VLLM_GLM53_B12X_STATIC_MAC_LADDER=""
VLLM_GLM53_B12X_DYNAMIC_MAC_LADDER=""
# STATIC_V2: the decode-streaming rewrite of the static (decode) MoE kernel
# (module b12x_zero_weight_micro, moe_static_kernel_v2.py): gate+up in one
# TMA pipeline, FC2 on its own stages, no item-boundary barrier, 32-row A
# box. Exact GLM TP geometry only. "" = stock kernel, "1" = the v2 default
# config (m32,f2,g4,a32), "m32,f2,g4,a32[,s]" a v2 config, "w" = v3 (FC1 as
# two 64-wide halves over 256-wide K stages: 128 B w13 row segments; f2,g3).
# 35차 (operator, 2026-09-06): v3 is the DEFAULT after PR #332 -- the kernel
# probes read U=40 728 -> 657-678 us (+7~10%, 3 shapes' numerics PASS); the
# first production boot on it is the serving bracket (proof line
# "[b12x static v2] lane serving: static2_...w" in the capture log).
# 38차 (operator "승격", 2026-09-06): "u" = v4 (moe_static_kernel_v4.py: FC1
# halves over 512-wide K stages, gate and up in separate 32 KB stages =
# 256 B w13 row segments, FC2 2 stages, smem 101,376 B) is the DEFAULT --
# probes U=40 672 -> 648 us (-3.5% vs v3, +9.8% vs stock), one-shot bench
# decode windows 21.9/21.9/20.9 vs 21.4/21.4/20.7 step/s (+2%), prefill,
# quality 9/9 and Korean 0/9 unchanged (proof line "...tm32f2g2a32wu").
# Rollback = "w" (v3) or "" (stock) on this line.
VLLM_GLM53_B12X_STATIC_V2=u

# b12x, never marlin: naming the backend makes an unsupported config raise, while
# auto quietly falls back to a path that dequantizes FP4 to bf16.
# The kernel family is the same; the name is not. DSV4 serves mxfp4 and calls
# it `b12x`, this image serves nvfp4 and calls it `flashinfer_b12x`.
MOE_BACKEND="flashinfer_b12x"
# b12x EP is overlay-side (flashinfer_b12x_moe.py remaps onto a local-only
# wrapper). Off until a boot measures it: the TP-sharded path is the one
# that serves today. ENABLE_EP=1 is --enable-expert-parallel.
ENABLE_EP=0
# Default EP uses local-only top_k=1 calls. No physical dummy row or unused
# top_k=8 wrapper is allocated. Set 0 for one boot to restore that fallback.
VLLM_B12X_EP_NO_DUMMY=1
# Experimental stock-dispatch top-k=8 lane. Exact 1 only; it sanitizes remote
# ids inside each token and keeps every call under the ordinary 8-token/40-row
# micro cutovers. Stable 8/16/32 decode tokens become 2/4/7 calls instead of
# the default #146 fallback's 8/16/32. GPU numerical/capture proof is pending.
VLLM_B12X_EP_STOCK_TOPK_MICRO=0
# Experimental pure top-k=8 micro lane. Exact 1 only, and only with the
# local-only setting above plus VLLM_B12X_EP_DISABLE_MICRO=0. Stable 8/16/32
# decode tokens become 1/2/4 calls; every other shape keeps the fixed fallback.
# No fleet numerical or E2E win is established, so default stays off.
VLLM_B12X_EP_ZERO_WEIGHT_MICRO=0
# Arms the fused gate. VLLM_DSV4_GATE_FUSED still works; this is the neutral
# name for a module that is not DSV4's.
# These three read 1 from the day they were written and never reached a
# container -- the launcher did not pass profile env, so every module they gate
# ran its stock path. The plumbing carries them now and the operator's call is
# to arm them, so the next boot is the first time any of these executes on this
# model. If a corruption number moves after that boot, the cause is not
# attributable to one of them from that run alone -- isolate by taking them
# down one at a time (VLLM_MOE_GATE_FUSED=0 ./start... for a single run).
VLLM_MOE_GATE_FUSED=1
# fp8 draft head (deepgemm W8A16) -- the variant adopted on this fleet, not
# the rowwise _scaled_mm one that was measured and rejected.
VLLM_SPEC_FP8_LM_HEAD=1
# Target head fp8 halves 0.32 GB/rank/step; the same knob measured C=1 +2.7%
# on DSV4. Armed by operator decision.
#
# What that decision accepts: the target's logits pick the sampled token and
# the accept/reject, so unlike the draft head they are outside what rejection
# sampling guarantees -- a quantization error here changes output rather than
# just acceptance. DSV4 adopted it behind a greedy-divergence gate; GLM has no
# such gate yet, and its Korean-token corruption is still unexplained, so an
# isolation run wanting a clean single variable should set this back to 0
# alongside DECIDE_SPEC=0.
VLLM_TARGET_LM_HEAD_FP8=1
# W4 vocab head on the megakernel's v2 lane (30차 §13; needs MK_GEMM=1 and
# MK_GEMM2=1, the persistent kernel was never sized for 303 tiles). The fp8
# head above is 158 MB/rank read at ~190 GB/s -- 836 us, twice a step (target
# verify + draft candidates) -- and already at the DRAM floor for fp8 bytes;
# the W4 pack halves the bytes (the v1 lane measured 418 us, 33차). DRAFT
# first: a coarser draft head only moves acceptance (bracket: acc-normalised
# step/s, pos-1 within 2 pct). TARGET is the served logits -- the decision
# VLLM_TARGET_LM_HEAD_FP8 documents, one notch coarser -- so it is armed only
# by operator decision, after the draft-head bracket and the boot's own
# first-call fidelity line ("head lane serving ... vs fp8: argmax N/N").
VLLM_GLM53_MK_HEAD_DRAFT=0
VLLM_GLM53_MK_HEAD_TARGET=0
# --- acceptance-gap experiment (pre-registered, one numerics change/boot) ----
# pos-1 acceptance 63.1% here vs dsv4's 78.5% on this fleet is ~1.66x
# tokens/step -- the biggest tok/s multiplier left. Both spec heads run fp8
# (SPEC = drafter candidates, TARGET = verify logits), but dsv4 measured its
# 78.5% WITH fp8 heads on both ends too, so head precision is the hypothesis
# to RETIRE first, not assume:
#   boot A: VLLM_SPEC_FP8_LM_HEAD=0    -> pos-1 delta = drafter-head cost
#   boot B: VLLM_TARGET_LM_HEAD_FP8=0  -> pos-1 delta = target-head cost
# Verdict: both deltas within +/-2 pct => precision retired; the gap then
# lives in the drafter itself or bench content (dsv4's 78.5% came from its
# own bench mix) -- DRAFT_TP and content-matched benches are the next axes.
# DFlash2 context KV is built only for tokens that pass through the target.
# vLLM enables automatic prefix caching by default, but cache-hit tokens skip
# that forward and this image still lets the drafter attend to their unwritten
# KV slots (upstream draft PR #47926). Prefer acceptance correctness over TTFT
# reuse until that multi-file runtime fix lands. Set 1 only as an explicit
# throughput-first rollback for a workload known not to reuse prefixes.
PREFIX_CACHE=0
# The drafter's block is 8; 7 is that minus the verified token. The launcher's
# default of 4 contradicts its own comment.
SPEC_K=5
# Drafter on rank 0 only: no per-draft collectives, no sharded draft KV.
DRAFT_TP=1
# Rejection sampling sees the drafter's real distribution (image default
# "greedy" is one-hot -> accept degenerates at temp>0; the DFlash2 reference
# config ships probabilistic). Rollback for A/B: DRAFT_SAMPLE=greedy.
DRAFT_SAMPLE=probabilistic
# custom_ops fusion-barrier A/B (#108's open axis): the image's default
# "custom_ops":["all"] makes EVERY registered custom op an opaque boundary
# to inductor -- 483 elementwise kernels/step (25.6%, 10.7/layer) survive
# because nothing fuses across those walls. Never A/B'd on this stack.
#   "" = no opaque custom ops -> inductor fuses through (the experiment)
#   "all" = the image default (control arm)
# CAUTION: some ops may REQUIRE opacity (quant, attention metadata) -- if
# the boot fails or numerics gate fails, the answer is "barrier necessary"
# and that closes the axis with evidence. One boot decides.
CUSTOM_OPS_AXIS=all
# Draft KV stays bf16 while the target keeps fp8_ds_mla, and the draft attention
# backend is left unpinned (SM121 picks FLASH_ATTN; TRITON_ATTN is a known trap).
DRAFT_KV="auto"
# --- memory budget (measured 2026-08-30, TP=4, GRAPH_CAP=16) ------------------
# Weights + activations take ~78 GiB per rank, so GMU has to clear that before
# there is any KV at all:
#
#   GMU 0.60 (71.8 GiB)  ->  Available KV cache memory: -5.67 GiB
#   GMU 0.65 (77.8 GiB)  ->  Available KV cache memory: -2.06 GiB
#
# The KV number gets *worse* as GMU comes down, which reads like the opposite of
# what it is: backing off after an OOM is the wrong reflex here. CUDA graphs are
# not the problem either -- at GRAPH_CAP=16 they cost 1.10 GiB.
#
# The other half is that free memory measured before launch is not the free
# memory the engine sees: `docker run` pulls the ~31 GB image through the page
# cache first, and ~11 GiB is gone by the startup check (101.6 -> 90.19,
# 102.6 -> 90.49, 113 -> 90.5 on three attempts). So:
#
#   GMU = (min MemFree across nodes - 11 - margin) / 119.69
#
# launchers/memfree-preflight.sh does that, and also kills the idle Gradle
# daemons that otherwise sit on ~10 GiB of whichever node last built the Android
# client. They do not show up in `docker stats`; the tell is AnonPages, 22.6 GiB
# on that node against 2.2 on its peers.
GMU_NOTE="weights+act ~78 GiB/rank; raise GMU, do not lower it"
GMU=0.73                # measured floor; 0.85 does not boot
EAGER=0                 # graphs on -- eager was rejected on speed
# max_num_seqs * (1 + num_spec) = 4 * 8 = 32 is the largest uniform-decode
# batch, and at 16 the 24- and 32-token verify steps had no graph at all --
# C=4 measured 45.0 tok/s against C=2's 43.6, which is no scaling. The whole
# capture costs 0.22 GiB, not the 1.10 this comment used to claim.
GRAPH_CAP=32
KV_DTYPE=fp8_e4m3       # auto = bf16, for isolating KV quantization
# KDA conv-state dtype (--mamba-cache-dtype; the recurrent state is fp32
# regardless). auto = model dtype (bf16). MK_SEG_KDA indexes an fp32 conv
# state, so its layout gate rejects every layer under auto ("conv state is
# torch.bfloat16(1056, 6144, 10)", 28차: the segment armed and never
# served). float32 is the config that lets the KDA shadow/bracket run at all
# (260 MB/rank). Profile-declared: pass as caller env.
MAMBA_CACHE_DTYPE=auto
MAX_SEQS=4
# Chunked-prefill budget. 2048 was the inherited value and the engine warned
# about it on every boot ("max_num_scheduled_tokens is set to 2048 based on the
# speculative decoding settings ... may lead to suboptimal performance"). The
# warning was right and nobody had measured it.
#
# 75K fresh-prompt prefill, three runs each (2026-08-31, bench-tp4):
#
#   2048   1,593 tok/s   47.2 s   run-to-run spread 35.4%
#   4096   1,828 tok/s   41.1 s                     12.0%   +14.7%
#   8192   2,110 tok/s   35.5 s                      0.9%   +32.4%
#
# Decode is untouched: C=1 step/s 15.03 -> 14.98 (-0.3%, inside the 1.9% CV).
# This is a prefill knob and it only shows up there -- measuring decode alone
# would have called it a null.
#
# The spread collapsing from 35% to 1% matters as much as the mean: at 2048 the
# first run of every set came in ~30% low (chunk-boundary warmup), and at 8192
# the three runs are 2,098 / 2,114 / 2,117. The engine's warning is gone at
# this value.
#
# Agent traffic is long-prompt dominated (wiki recall, documents, code context),
# so this is the one axis measured today that moves what a request actually
# waits for. Raise further only with a boot: activation memory scales with it
# and GMU is 0.62.
MAX_BATCHED=8192
MAX_LEN=1048576
# Engine-level prefill JIT warmup (launchers/prefill-warmup.py): PR #192's
# one OPEN prefill target is the cold tax (11-41% on the first request per
# length; warm sits at 97% of the goal line). 1 = the launcher fires one
# real prefill per length below once the server answers -- exact token
# counts via /tokenize, distinct content per request, outputs discarded,
# numerics-neutral. rep1-vs-rep2 in the boot log is the receipt that the
# tax existed and is now paid. Costs the tax once at boot instead of on
# the first user request.
#   DEFAULT ON since 33차 (2026-09-05): the ledger's named remaining prefill
#   target. Receipt = glm53-logs/prefill-warmup.log rep1-vs-rep2 + the first
#   post-warmup request landing on the warm number. The bracket harnesses
#   (ab-lever.sh, ab-glm53.sh) pin 0 for their own boots -- the cold/warm
#   channel is their measurement, and the warmup's six requests would land
#   inside the first decode leg's windows. 0 stays the kill switch.
PREFILL_WARMUP=1
PREFILL_WARMUP_LENS="2048,4096,8192"

# LM head rows the tokenizer cannot decode (154856..154879 here) are live
# argmax candidates: config vocab_size sets both the head width and
# org_vocab_size, so vLLM's logits slice is a no-op. glm5next_model masks them.
# Empty = read the bound from the tokenizer (the right default; a literal goes
# quietly wrong the day the model changes).
VLLM_GLM53_DECODABLE_VOCAB=
# 1 = also count how often a masked row was about to win, logged every 256
# calls. Two vocab reductions per step plus one sync per 256; off by default.
VLLM_GLM53_VOCAB_MASK_AUDIT=0

# Host-register RDMA one-shot AllReduce (overlay/modules/tp_oneshot_ar), 27us
# against NCCL's 67us on this fabric. It matters here because every accelerated
# collective backend falls away on this hardware: the engine reports
#   Using ['PYNCCL'] ... out of ['NCCL_SYMM_MEM','QUICK_REDUCE','FLASHINFER',
#   'AITER_CUSTOM','CUSTOM','SYMM_MEM','PYNCCL']
#   SymmMemCommunicator: Device capability 12.1 not supported
#   Custom collectives are disabled because this multi-node group does not
#   support MNNVL multicast
# so TP=4 pays plain NCCL for ~90 collectives per decode step. The module
# bootstraps only at world_size 4 and every failure path returns to NCCL.
#
# Declared here because the launcher forwards only VLLM_* it finds in the
# profile -- set on the command line alone they never reach the container.
VLLM_DSV4_ONESHOT_AR=1
# Measured on this fleet, RedHat weights, dflash k=7, only this knob moved:
#   C=1 29.4 -> 32.3 (+10%)   C=2 43.3 -> 51.1 (+18%)   C=4 unresolved
#   corruption 0.0/M either way (0/16 over 32,615 chars)
#   boot self-test: div=0 against NCCL on all four ranks
# C=4 spread was 53.0-68.5 across reps, so that end is not settled.
#
# 1 = boot self-test then stay on NCCL (observe only). 0 = actually serve from it.
VLLM_DSV4_ONESHOT_SHADOW=0
