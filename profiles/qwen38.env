# Qwen3.8-Flash-Next NVFP4 -- 4x DGX Spark GB10, TP=4 with EXPERT PARALLEL.
#
# "TEP=4" is TP=4 + EP, and the EP is not an option.
#
#   moe_intermediate_size 640 split over 4 ranks is 160
#     -> 320 gate+up rows, 320 % 128 = 64
#   The FP4 MoE backends cannot tile that without padding w1/w3, and padding
#   this branch is recorded as booting, passing HEALTH-OK, and then answering
#   '1' to '안녕하세요' and looping forever on '360과 168의 최대공약수'
#   (MEASUREMENTS.md). Not a performance choice: a correctness one.
#
#   EP hands each rank 128 whole experts of 512, so the intermediate stays 640
#     -> 1280 gate+up rows, 1280 % 128 = 0.
#
# The shared expert was the hole in that -- TP-split to the same misaligned
# 160. qwen38_moe fuses it into the routed grouped GEMM as an eleventh,
# RANK-LOCAL slot so it inherits the 640 too. Bit-exact against the
# two-computation oracle; see that module's README.
PROFILE_DESC="Qwen3.8-Flash-Next NVFP4 TEP=4 (TP=4 + expert parallel)"
PROFILE_IMAGE="qwen38-fi618:local"   # tools/qwen38-fi618.Dockerfile: qwen38-flash-next + the campaign's FlashInfer 0.6.18
PROFILE_MODEL_PATH="/home/choiceoh/models/qwen38-flash-next-nvfp4"
PROFILE_SERVED_NAME="Qwen3.8-Flash-Next"
PROFILE_LAUNCHER="start-qwen38-nvfp4-tep4.sh"

# The qwen38-flash-next image installs vLLM under dist-packages, like glm53's
# and unlike the ds4 image's venv. Module manifests give targets relative to
# this.
TARGET_PREFIX="/usr/local/lib/python3.12/dist-packages/"

# tp_oneshot_ar  the TP all-reduce shim, portable to any model
# qwen38_moe     shared expert fused into the routed grouped GEMM
# qwen38_ple     the 51 GiB PLE n-gram table: host-RAM offload + the on-device
#                FP8 embedding method an NVFP4 checkpoint otherwise never gets
# qwen38_qsa     QSA split-K cap for GB10 (upstream's profile is tuned on GB300)
# qwen38_spec    MTP spec-decode: the n-gram ordering fix and adaptive K
# dsv41_engram   NEW files only; here for its O_DIRECT row reader, which the
#                PLE SSD path imports (160-byte rows straddling sectors included)
# qwen38_b12x    the b12x lane: workspace bounds check + the dynamic kernel's
#                unrouted-slot guard (the IMA below), a generated override
MODULES="tp_oneshot_ar dsv41_engram qwen38_moe qwen38_ple qwen38_qsa qwen38_spec qwen38_b12x"

# --- b12x on this model: the IMA, found and closed ------------------------
# 2026-09-11, srv4, TP=1, --load-format dummy. Every boot died in
# launch_sm120_dynamic_moe with cudaErrorIllegalAddress. It was not the
# shape: E=512 K=2560 N=640 top-10 runs on the stock kernel in all three b12x
# paths standalone. It was the ids. A hook on B12xMoEWrapper.run dumped the
# faulting call's arguments: every one of the 20,480 top-k slots was -1,
# vLLM's "unrouted" sentinel (its other backends honour it; utils.py: "The
# kernel uses -1 to represent invalid topk_ids"). The stock dynamic kernel
# does atomic_add(row_counts + expert_id) with no sign check, and
# compute-sanitizer on the replayed call says exactly that:
#
#   Invalid __global__ atomic of size 4 bytes ... is out of bounds
#   and is 4 bytes before the nearest allocation ... of size 2048 bytes
#
# 2048 = int32[512], the histogram. Standalone the write lands in a
# neighbour and nothing is reported; in the serving process it faults.
# Seven "hypotheses" were eliminated before this because each experiment
# changed something other than the ids -- the correction worth keeping is
# that the argument dump should have come first (tools/README: hook, dump,
# replay, sanitize).
#
# The fix is qwen38_b12x/moe_dynamic_generic.py, generated from the stock
# kernel by tools/qwen38_b12x_guard_gen.py: an id < 0 owns no row. Verified
# bit-identical to "valid id at weight 0" with 75% of slots unrouted -- which
# is also the TEP=4 route split, so the guard IS this model's EP path: no
# dummy expert, no GEMM work for the routes a rank does not own.
#
# Corrections worth keeping: --hf-overrides num_experts/num_experts_per_tok
# were IGNORED -- every run used the real 512 experts at top-10 (routed_rows
# 20480 = 2048 x 10) -- and so was num_hidden_layers: this model reads
# hf_text_config, and a top-level key never reaches it, so "48 layers fail
# like 4" compared 48 with 48. The whole model is ~116 GB on one Spark
# (60 GB experts + 51 GB PLE + attention) and earlyoom takes it at 5% free;
# a single-node check needs the NESTED form,
#   --hf-overrides '{"text_config": {"num_hidden_layers": 4}}'
#
# --- serving knobs ------------------------------------------------------
EXPERT_PARALLEL=1       # the launcher ABORTS on 0 at TP>1; see above
MOE_BACKEND=flashinfer_b12x
# The SM12x CuteDSL FP4 lane. vLLM's NvFp4 oracle deliberately excludes it from
# auto-selection, so it runs only when named. Empty falls back to Marlin, which
# is weight-only FP4 -- dequantize to bf16 and leave the FP4 tensor cores idle.

MAX_MODEL_LEN=196608
MAX_NUM_SEQS=2
MAX_NUM_BATCHED=16384
KV_DTYPE=bfloat16
GPU_MEM=auto            # probe every node, take the floor; see tp4-mem.sh

PLE_CPU_OFFLOAD=0       # NOT an option on the fleet: gpu_worker._validate_ple_offload_config
                        # RAISES at nnodes != 1 ("VLLM_PLE_CPU_OFFLOAD does not support ...
                        # nnodes=4"), so 1 aborts every multi-node boot. Single-node
                        # dev runs may set 1 (the 51 GiB table then lives in a CPU
                        # subprocess); the fleet keeps it on-device via FORCE_FP8_EMBED.
PLE_SSD=0               # 1: the table leaves the device -- each rank reads its own
                        # 11.9 GiB block from PLE_SSD_DIR (tools/qwen38_ple_shard.py)
PLE_SSD_DIR=/home/choiceoh/models/qwen38-ple-ssd
FORCE_FP8_EMBED=1       # required at TP>1: builds the FP8 embedding method the offload
                        # path would have fed; 51 GiB per rank on-device, replicated

# FULL_AND_PIECEWISE breaks during capture on this hybrid (36 linear + 12 full
# attention) model: "Constraints violated (L[query_start_loc].size()[0])".
CUDAGRAPH_MODE=PIECEWISE

SPEC_TOKENS=0           # MTP head; 0 until TEP=4 serves without it
ADAPTIVE_SPEC=0
NGRAM_FIX=0
QSA_MAX_SPLITS=0
ALL2ALL=
ASYNC=0
AUTOTUNE=1
FUSE=0
LOAD_FORMAT=fastsafetensors
# fastsafetensors 0.3.3 ships in the image and qwen38_ple/weight_utils.py
# carries the 2026-08-28 local mode (DENEB_FST_LOCAL=1, which the launcher
# sets for this format): every rank reads the checkpoint it already has on
# its own NVMe with direct IO into host memory, SingleGroup so the loader
# never opens a cross-node NCCL of its own, nogds because GB10 has no
# GPUDirect Storage. The default loader took 320 s for the 206 shards on the
# 2026-09-11 TEP=4 boots; this is the lever for that number.
# LOAD_FORMAT=dummy validates config paths first: dummy exercises backend
# selection, MoE construction, the alignment path, compilation, memory
# profiling and graph capture -- exactly the surfaces that fail -- in seconds.

SHARED_FUSE=0           # qwen38_moe's fused slot; off until the dispatch is wired
