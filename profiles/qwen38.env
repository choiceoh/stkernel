# Qwen3.8-Flash-Next NVFP4 -- 4x DGX Spark GB10, TP=4. Bring-up, not production.
#
# b12x at TP=4 (EP off) is still closed: 640/4 = 160 -> 320 gate+up rows, not
# a multiple of 128, and padding this branch answers '1' to '안녕하세요'
# (MEASUREMENTS.md). EP=4 is the remaining door -- full intermediate 640 is
# 1280 gate+up rows, which aligns -- once this profile mounts
# b12x_shared_workspace and a launcher that forwards ENABLE_EP=1.
PROFILE_DESC="Qwen3.8-Flash-Next NVFP4 TP=4 (bring-up)"
PROFILE_IMAGE=""
PROFILE_MODEL_PATH="/home/choiceoh/models/qwen38-flash-next-nvfp4"
PROFILE_SERVED_NAME="qwen3.8-flash-next"
PROFILE_LAUNCHER="start-qwen38-nvfp4-tp4.sh"

# The shared expert is fused into the routed grouped GEMM as an eleventh slot
# (qwen38_moe). That is what gives it EP's alignment -- 640 stays 640, so
# gate+up is 1280 rows and not the 320 a TP split would make. Padding that
# misalignment is recorded as booting and then destroying the model.
MODULES="tp_oneshot_ar qwen38_moe"
