# Qwen3.8-Flash-Next NVFP4 -- 4x DGX Spark GB10, TP=4 with EXPERT PARALLEL.
#
# "TEP=4" is TP=4 + EP, and the EP is not an option.
#
#   moe_intermediate_size 640 split over 4 ranks is 160
#     -> 320 gate+up rows, 320 % 128 = 64
#   The FP4 MoE backends cannot tile that without padding w1/w3, and padding
#   this branch is recorded as booting, passing HEALTH-OK, and then answering
#   '1' to '안녕하세요' and looping forever on '360과 168의 최대공약수'
#   (MEASUREMENTS.md). Not a performance choice: a correctness one.
#
#   EP hands each rank 128 whole experts of 512, so the intermediate stays 640
#     -> 1280 gate+up rows, 1280 % 128 = 0.
#
# The shared expert was the hole in that -- TP-split to the same misaligned
# 160. qwen38_moe fuses it into the routed grouped GEMM as an eleventh,
# RANK-LOCAL slot so it inherits the 640 too. Bit-exact against the
# two-computation oracle; see that module's README.
PROFILE_DESC="Qwen3.8-Flash-Next NVFP4 TEP=4 (TP=4 + expert parallel)"
PROFILE_IMAGE="vllm/vllm-openai:qwen38-flash-next"
PROFILE_MODEL_PATH="/home/choiceoh/models/qwen38-flash-next-nvfp4"
PROFILE_SERVED_NAME="Qwen3.8-Flash-Next"
PROFILE_LAUNCHER="start-qwen38-nvfp4-tep4.sh"

# The qwen38-flash-next image installs vLLM under dist-packages, like glm53's
# and unlike the ds4 image's venv. Module manifests give targets relative to
# this.
TARGET_PREFIX="/usr/local/lib/python3.12/dist-packages/"

# tp_oneshot_ar  the TP all-reduce shim, portable to any model
# qwen38_moe     shared expert fused into the routed grouped GEMM
# qwen38_ple     the 51 GiB PLE n-gram table: host-RAM offload + the on-device
#                FP8 embedding method an NVFP4 checkpoint otherwise never gets
# qwen38_qsa     QSA split-K cap for GB10 (upstream's profile is tuned on GB300)
# qwen38_spec    MTP spec-decode: the n-gram ordering fix and adaptive K
MODULES="tp_oneshot_ar qwen38_moe qwen38_ple qwen38_qsa qwen38_spec qwen38_b12x"

# --- b12x on this model: six hypotheses, five dead ----------------------
# 2026-09-11, srv4, TP=1, --load-format dummy, exclusive GPU, b12x named.
#
# The lane is selected -- `Using 'FLASHINFER_B12X' NvFp4 MoE backend` -- and
# then dies. What it is NOT, each by an experiment:
#
#   NOT the hyper-connection kernel. The first traceback named
#     ops/hc.py:249 _hc_combine. CUDA errors are asynchronous and
#     `_init_handles` is where a previous fault is first noticed;
#     CUDA_LAUNCH_BLOCKING=1 names launch_sm120_dynamic_moe instead.
#   NOT our overlays. The stock image with zero overlays fails identically.
#   NOT layer truncation. 48 layers fail the same way as 4.
#   NOT the FlashInfer version. Rebuilt the image on the
#     0.6.18.dev20260819 this fleet runs b12x on in production (see
#     tools/qwen38-fi618.Dockerfile) -- same IMA. That rebuild is still
#     worth having: it puts Qwen on the base our whole b12x campaign
#     overrides (preimage f6923850...), which 0.6.17 cannot host.
#   NOT workspace capacity. The bounds check added to our own
#     moe_dispatch.py measures it, and nothing is short:
#
#       [b12x-bounds] state_E=512 n=640 tile_m=32 routed_rows=20480
#                     -> rows 36832/36832 tiles 1151/1151 tasks 5755/5755
#
#   NOT tile_m. DENEB_B12X_TILE_M pins it; 32, 64 and 128 all fail, and the
#     capacities match exactly in each.
#
# WHAT IS LEFT. n=640 divides _LEVEL_TILE_N=128 evenly -- but into FIVE
# tiles. GLM-5.3's 512 and 2048 give 4 and 16. `slice_groups` is
# ceil(gate_tile_cnt / _DYNAMIC_SLICE_CHUNK), so an odd tile count leaves a
# partial last group, and a kernel that assumes full groups reads past it.
# That is the next thing to instrument.
#
# A correction worth keeping: --hf-overrides num_experts/num_experts_per_tok
# were IGNORED. Every run reported above used the real 512 experts at top-10
# (routed_rows 20480 = 2048 x 10), so nothing here was measured on a reduced
# model, whatever the command line said.
#
# --- serving knobs ------------------------------------------------------
EXPERT_PARALLEL=1       # the launcher ABORTS on 0 at TP>1; see above
MOE_BACKEND=flashinfer_b12x
# The SM12x CuteDSL FP4 lane. vLLM's NvFp4 oracle deliberately excludes it from
# auto-selection, so it runs only when named. Empty falls back to Marlin, which
# is weight-only FP4 -- dequantize to bf16 and leave the FP4 tensor cores idle.

MAX_MODEL_LEN=196608
MAX_NUM_SEQS=2
MAX_NUM_BATCHED=16384
KV_DTYPE=bfloat16
GPU_MEM=auto            # probe every node, take the floor; see tp4-mem.sh

PLE_CPU_OFFLOAD=1       # keep the 51 GiB n-gram table in host RAM
FORCE_FP8_EMBED=1       # required at TP>1: the offload path is gated to nnodes=1

# FULL_AND_PIECEWISE breaks during capture on this hybrid (36 linear + 12 full
# attention) model: "Constraints violated (L[query_start_loc].size()[0])".
CUDAGRAPH_MODE=PIECEWISE

SPEC_TOKENS=0           # MTP head; 0 until TEP=4 serves without it
ADAPTIVE_SPEC=0
NGRAM_FIX=0
QSA_MAX_SPLITS=0
ALL2ALL=
ASYNC=0
AUTOTUNE=1
FUSE=0
LOAD_FORMAT=
# Config paths are validated with LOAD_FORMAT=dummy first: 206 shards take
# about 6 minutes to load, and dummy exercises backend selection, MoE
# construction, the alignment path, compilation, memory profiling and graph
# capture -- exactly the surfaces that fail -- in seconds. 15 min -> 3 min.

SHARED_FUSE=0           # qwen38_moe's fused slot; off until the dispatch is wired
