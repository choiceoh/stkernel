# tools/devenv: the development environment srv1..srv4 and ost-97x (the RTX 5050 PC) hold (node.sh) and the Mac's venv
# (mac.sh), one version a tool. The repo is the source: change a line in a PR, and srv4's devenv-sync timer applies main's
# copy to every node the next morning (sync.sh). Sourced by bash and zsh -- plain assignments only.
DEVENV_MANIFEST=1

# Python: the system python3 (3.12) on the nodes, its user site; ~/.venvs/stkernel on the Mac
PYTHON_VERSION=3.12                               # the Mac's venv (uv-managed); one made with another Python is set aside
TORCH_VERSION=2.12.1                             # the nodes take the CUDA 13.0 build below, the Mac the macOS wheel
TORCH_INDEX=https://download.pytorch.org/whl/cu130
TRITON_VERSION=3.7.1                              # the Triton that torch build pins; there is none for macOS
PY_PACKAGES="numpy==2.4.3 safetensors==0.7.0 tokenizers==0.23.1 Jinja2==3.1.6 huggingface_hub==1.30.0 ruff==0.15.21 py-spy==0.4.2 codespell==2.4.2"
GRAPHIFY_VERSION=0.4.19                           # the extractor graphify-out/ was made with (graphify-out/README.md)

# single binaries in ~/.local/bin on the nodes, aarch64 or x86_64 builds (the Mac keeps Homebrew's)
UV_VERSION=0.11.26
GH_VERSION=2.95.0
NODE_VERSION=24.18.0
MERGIRAF_VERSION=0.17.0                           # git's merge driver (merge.mergiraf)
WORKTRUNK_VERSION=0.68.0                          # wt

# each release archive's SHA-256, per architecture: node.sh unpacks nothing else. A version change comes with new lines
# from `bash tools/devenv/node.sh --digests`. These matched the publishers' checksum files (uv, gh, node, worktrunk)
# and, for mergiraf, which publishes none, the binaries the nodes had installed (2026-09-19).
UV_SHA256_AARCH64=befa1a59c91e96eb601b0fd9a97c03dd666f17baba644b2b4db9c59a767e387e
GH_SHA256_AARCH64=d41e0b3b6218e5741c8bb4db39b16e53a59e0e06299a8489bd38f623ef7ebaae
MERGIRAF_SHA256_AARCH64=df1f8111acb6df3fa6b9fa9977bd18b7ef8fc1f814b8d81f426602f9fb4f547a
WORKTRUNK_SHA256_AARCH64=c03c58053a0b68849a9238fcc50271804c63e885d1ef1b3f539b2be44be26cdb
NODE_SHA256_AARCH64=58c9520501f6ae2b52d5b210444e24b9d0c029a58c5011b797bc1fe7105886f6
UV_SHA256_X86_64=6426a73c3837e6e2483ee344cbc00f36394d179afcba6183cb77437e67db4af0
GH_SHA256_X86_64=25d1e4729e8808c9ed3d613e96ebd3f3e44446f2d368c89d878a71a36ddb3d8c
MERGIRAF_SHA256_X86_64=8affcef50b86ce7ed450147f894ba3688bf3925bcbc2a9b3af2074d27e79e7c9
WORKTRUNK_SHA256_X86_64=3378ee6a63ca438ac60687c5e6204e06ce694fed41ad57ef6aa54451b10231ed
NODE_SHA256_X86_64=55aa7153f9d88f28d765fcdad5ae6945b5c0f98a36881703817e4c450fa76742

# the agent CLIs: installed where missing, never pinned -- they update themselves
AGENT_NPM="@openai/codex @anthropic-ai/claude-code"
